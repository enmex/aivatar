# Скопируйте в .env. Ключ доступен только серверу.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=local_dev_change_me
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# true при публикации за HTTPS reverse proxy
COOKIE_SECURE=false
# Для локального Node.js задайте URL доступного Postgres.
# DATABASE_URL=postgresql://ai_gateway:local_dev_change_me@localhost:5432/ai_gateway
